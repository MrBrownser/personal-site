---
const hasAvatar = false; // set true if public/images/avatar.jpg is added
---

<section
  id="hero"
  class="relative flex min-h-screen flex-col items-center justify-center px-6 pt-20"
  aria-label="Hero"
>
  <div class="flex flex-col items-center gap-10 text-center">
    <!-- Avatar: neumorphic frame -->
    <div
      class="rounded-full p-3"
      style="box-shadow: var(--neu-raised)"
    >
      <div
        class="overflow-hidden rounded-full"
        style="box-shadow: var(--neu-inset)"
      >
        {hasAvatar ? (
          <img
            src="/images/avatar.jpg"
            alt="Portrait of Adrià Castany Serrano"
            width="180"
            height="180"
            class="h-36 w-36 rounded-full object-cover md:h-44 md:w-44"
            fetchpriority="high"
          />
        ) : (
          <span
            class="flex h-36 w-36 items-center justify-center rounded-full bg-background text-3xl font-bold text-primary md:h-44 md:w-44 md:text-4xl"
            aria-hidden="true"
          >
            AC
          </span>
        )}
      </div>
    </div>

    <div class="flex flex-col items-center gap-4">
      <h1 class="text-balance text-5xl font-extrabold tracking-tight text-foreground md:text-7xl lg:text-8xl">
        Adrià Castany Serrano
      </h1>
      <p class="max-w-lg text-pretty text-lg font-medium tracking-wide text-muted-foreground md:text-xl">
        Head of Product &amp; Tech. Builder. Learner.
      </p>
      <p class="max-w-md text-pretty text-base leading-relaxed text-muted-foreground/80">
        Bridging technology, product strategy, and teams that never stop learning.
      </p>
    </div>

    <div class="flex flex-col items-center gap-4 sm:flex-row">
      <a
        href="#about"
        class="inline-flex items-center gap-2 rounded-xl bg-primary px-8 py-3.5 text-sm font-semibold text-primary-foreground transition-all active:scale-[0.97]"
        style="box-shadow: 6px 6px 12px var(--neu-shadow-dark), -6px -6px 12px var(--neu-shadow-light)"
      >
        Explore My Journey
      </a>
      <a
        href="#contact"
        class="inline-flex items-center gap-2 rounded-xl bg-background px-8 py-3.5 text-sm font-semibold text-foreground transition-all active:scale-[0.97]"
        style="box-shadow: var(--neu-raised-sm)"
      >
        Get In Touch
      </a>
    </div>
  </div>

  <div class="absolute bottom-10 left-1/2 -translate-x-1/2">
    <a
      href="#about"
      class="flex h-12 w-12 items-center justify-center rounded-full text-muted-foreground transition-colors hover:text-primary"
      style="box-shadow: var(--neu-raised-sm)"
      aria-label="Scroll to about section"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5 animate-bounce"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</section>
